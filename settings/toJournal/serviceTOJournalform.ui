<?xml version="1.0" encoding="UTF-8"?>
<!-- Журнал ТО — форма экрана (1024×600, координаты по макетам Ивана). Версия 02, 2026-09-29. Qt 5.15. Изменения от 01: шрифт Manrope (встроен в модуль) во всех стилях. -->
<ui version="4.0">
 <class>ServiceTOJournalForm</class>
 <widget class="QWidget" name="ServiceTOJournalForm">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1024</width><height>600</height></rect></property>
  <property name="windowTitle"><string>ТО-журнал</string></property>
  <property name="styleSheet"><string>QWidget#ServiceTOJournalForm { background:#0d1117; }
QStackedWidget, QWidget#page_journal, QWidget#page_perform, QWidget#page_procs { background:transparent; }
QLabel { background:transparent; color:#e8e9ea; }
QFrame[panel="true"] { background:#15191f; border-radius:10px; }
QFrame[sep="true"] { background:#0d1117; border:none; }
QFrame[hline="true"] { background:#34373c; border:none; }
QFrame[accent="true"] { background:#f0a500; border-radius:2px; }
QPushButton[pill="true"] { background:#1d2127; color:#ffffff; border:none; border-radius:26px; }
QPushButton[pill="true"]:pressed { background:#2a3037; }
QPushButton#pushButton_delete, QPushButton#pushButton_save { background:#15191f; color:#ffffff; border:none; font-family: "Manrope"; font-weight: bold; font-size: 15px; }
QPushButton#pushButton_delete { border-bottom-left-radius:10px; }
QPushButton#pushButton_save { border-bottom-right-radius:10px; }
QPushButton#pushButton_delete:pressed, QPushButton#pushButton_save:pressed { background:#1d2127; }
QScrollArea { background:transparent; border:none; }
QScrollArea &gt; QWidget &gt; QWidget { background:transparent; }
QScrollBar:vertical { background:transparent; width:4px; margin:0; }
QScrollBar::handle:vertical { background:#34373c; border-radius:2px; min-height:40px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background:none; }
QComboBox#comboBox_to { background:#15191f; color:#ffffff; font-family: "Manrope"; font-weight: bold; font-size: 15px; border:2px solid #34373c; border-radius:26px; padding-left:20px; }
QComboBox#comboBox_to::drop-down { width:48px; border:none; }
QComboBox#comboBox_to::down-arrow { image:url(:/Images/settings/toJournal/combo_arrow.png); width:19px; height:11px; }
QComboBox#comboBox_to QAbstractItemView { background:#1d2127; color:#ffffff; font-family: "Manrope"; font-weight: bold; font-size: 15px; border:2px solid #34373c; selection-background-color:#2a3037; outline:0; }
QLineEdit#lineEdit_executor { background:#1d2127; color:#ffffff; font-family: "Manrope"; font-size: 14px; border:1px solid transparent; border-radius:26px; padding:0 22px; }
QLineEdit#lineEdit_executor[error="true"] { border:1px solid #d2281f; }
QLineEdit#lineEdit_name { background:transparent; color:#ffffff; font-family: "Manrope"; font-weight: bold; font-size: 15px; border:none; padding:0; }
QPushButton#pushButton_intervalDown { border-image:url(:/Images/settings/toJournal/btn_left.png); }
QPushButton#pushButton_intervalDown:pressed { border-image:url(:/Images/settings/toJournal/btn_left_pressed.png); }
QPushButton#pushButton_intervalUp { border-image:url(:/Images/settings/toJournal/btn_right.png); }
QPushButton#pushButton_intervalUp:pressed { border-image:url(:/Images/settings/toJournal/btn_right_pressed.png); }
QPushButton#pushButton_addWork { border-image:url(:/Images/settings/toJournal/btn_add.png); }
QPushButton#pushButton_addWork:pressed { border-image:url(:/Images/settings/toJournal/btn_add_pressed.png); }
QPushButton#pushButton_exit { border-image:url(:/Images/settings/toJournal/btn_exit.png); }
QPushButton#pushButton_exit:pressed { border-image:url(:/Images/settings/toJournal/btn_exit_pressed.png); }
</string></property>
